# --- секреты ---
# Сгенерировать новый ключ: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-insecure-key-change-me
DEBUG=True

# Домены, с которых разрешён доступ (через запятую). Пример: localhost,127.0.0.1,academy.example.uz
ALLOWED_HOSTS=localhost,127.0.0.1

# --- сайт ---
SITE_NAME=Академия Ибн Усаймина
# Тема по умолчанию для новых посетителей: paper (классика) | sand (минимал)
SITE_THEME_DEFAULT=paper
# Адрес сайта (для robots.txt и карты сайта). В проде: https://academy.example.uz
SITE_URL=http://127.0.0.1:8000
# True только когда сайт работает за HTTPS (включает строгие cookie и HSTS)
SITE_HTTPS=False

# --- база данных ---
# sqlite — для разработки (файл db.sqlite3, ничего ставить не нужно)
# postgres — для продакшена
DB_ENGINE=sqlite
DB_NAME=academy
DB_USER=academy
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# --- почта (для сброса пароля) ---
# В разработке письма печатаются в консоль сервера.
EMAIL_BACKEND=console
# Для продакшена раскомментируйте и заполните:
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=noreply@example.uz
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=Академия Ибн Усаймина <noreply@example.uz>
